DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mo3allimai
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI-compatible Groq provider (keep the real key only in backend/.env)
RAG_LLM_PROVIDER=openai_compatible
RAG_LLM_BASE_URL=https://api.groq.com/openai/v1/
RAG_LLM_API_KEY=YOUR_GROQ_API_KEY
RAG_LLM_MODEL=llama-3.3-70b-versatile
ASSISTANT_LLM_MAX_OUTPUT_TOKENS=1800

# Optional independent reviewer provider. Leave disabled when no second key is available.
ARABIC_REVIEW_MAX_RETRIES=1
ARABIC_REVIEW_RETRY_JITTER_SECONDS=0.25
ARABIC_REVIEW_FALLBACK_ENABLED=false
ARABIC_REVIEW_FALLBACK_PROVIDER=openai_compatible
ARABIC_REVIEW_FALLBACK_BASE_URL=
ARABIC_REVIEW_FALLBACK_API_KEY=
ARABIC_REVIEW_FALLBACK_MODEL=
